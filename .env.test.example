APP_NAME=GEOFlow-Test
APP_ENV=staging
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:18082

ADMIN_BASE_PATH=geo_admin
GEOFLOW_CONTENT_PRODUCTION_PIPELINE_ENABLED=true
GEOFLOW_ADMIN_USERNAME=admin
GEOFLOW_ADMIN_EMAIL=admin@test.local
GEOFLOW_ADMIN_PASSWORD=change-this-test-password

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=geo_flow_test
DB_USERNAME=geo_test
DB_PASSWORD=change-this-test-db-password
POSTGRES_DATA_DIR=./docker-data/test/postgres
POSTGRES_CONTAINER_DATA_DIR=/var/lib/postgresql/data
PGVECTOR_IMAGE=pgvector/pgvector:pg16

REDIS_IMAGE=redis:7-alpine
REDIS_HOST=redis
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=geoflow-test
REVERB_APP_KEY=geoflow-test-key
REVERB_APP_SECRET=change-this-test-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=18083
REVERB_SCHEME=http
REVERB_SERVER_PORT=18080

AUTO_MIGRATE=true
AUTO_INSTALL_ONCE=true
AUTO_OPTIMIZE=true
GEOFLOW_SECURITY_FRESH_INSTALL_CONFIRMED=false

COMPOSE_PROJECT_NAME=geoflow-test
APP_ENV_FILE=./.env.test
APP_STORAGE_DIR=./docker-data/test/storage
GEOFLOW_APP_IMAGE=geoflow-app-test:latest
GEOFLOW_WEB_IMAGE=geoflow-web-test:latest
POSTGRES_CONTAINER_NAME=geoflow-postgres-test
REDIS_CONTAINER_NAME=geoflow-redis-test
INIT_CONTAINER_NAME=geoflow-init-test
APP_CONTAINER_NAME=geoflow-app-test
WEB_CONTAINER_NAME=geoflow-web-test
QUEUE_CONTAINER_NAME=geoflow-queue-test
SCHEDULER_CONTAINER_NAME=geoflow-scheduler-test
REVERB_CONTAINER_NAME=geoflow-reverb-test
REDIS_DATA_VOLUME_NAME=geoflow-redis-test-data
WEB_PORT=18082
REVERB_EXPOSE_PORT=18083
DOCKER_NETWORK_NAME=geoflow-test-net
DOCKER_NETWORK_SUBNET=10.89.0.0/16
DOCKER_NETWORK_GATEWAY=10.89.0.1
